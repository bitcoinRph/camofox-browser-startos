{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:offline-benchmark:visits",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "1.1"
      },
      "visit_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "target_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "arm": {
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "A2",
          "C2"
        ]
      },
      "block": {
        "type": "integer",
        "minimum": 0
      },
      "position": {
        "type": "integer",
        "minimum": 0
      },
      "mode": {
        "enum": [
          "synthetic",
          "local-fixture-replay",
          "local-observation"
        ]
      },
      "elapsed_ms": {
        "type": "number",
        "minimum": 0,
        "maximum": 20000
      },
      "observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "http_status": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          },
          "usable_marker": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          },
          "frame_state": {
            "enum": [
              "none",
              "iframe",
              "frameset"
            ]
          },
          "tool_error": {
            "enum": [
              "none",
              "timeout",
              "transport"
            ]
          }
        },
        "required": [
          "http_status",
          "title",
          "text",
          "usable_marker",
          "truncated",
          "frame_state",
          "tool_error"
        ]
      },
      "label": {
        "enum": [
          "usable",
          "challenge",
          "captcha",
          "block",
          "error",
          "timeout",
          "incomplete"
        ]
      },
      "detector_version": {
        "const": "1.0"
      },
      "evidence_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "schema_version",
      "visit_id",
      "target_id",
      "arm",
      "block",
      "position",
      "mode",
      "elapsed_ms",
      "observation",
      "label",
      "detector_version",
      "evidence_sha256"
    ]
  }
}
