{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:offline-benchmark:targets",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "1.0"
      },
      "target_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "const": "owned"
      },
      "permission": {
        "const": "local-fixture"
      },
      "primary": {
        "type": "boolean"
      }
    },
    "required": [
      "schema_version",
      "target_id",
      "url",
      "kind",
      "permission",
      "primary"
    ]
  }
}
